# Cadena de conexión de Postgres (Neon o Supabase). En Vercel usa la del pooler.
DATABASE_URL=postgres://user:password@host:5432/stickshot
# Secreto de Auth.js. Genera uno con: npx auth secret  (o: openssl rand -base64 32)
AUTH_SECRET=
# Solo fuera de Vercel (p. ej. `pnpm start` en local o un servidor propio):
# Auth.js rechaza el host si no se marca como confiable. Vercel lo infiere solo.
# AUTH_TRUST_HOST=true
